{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!**/coverage", "!!**/dist", "!!**/out"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "nursery": {
        "noUnsafePlusOperands": "error",
        "useExhaustiveSwitchCases": "error"
      },
      "style": {
        "noNestedTernary": "error",
        "useBlockStatements": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        }
      },
      "suspicious": {
        "noEmptyBlockStatements": "error",
        "noExplicitAny": "error"
      }
    }
  },
  "assist": {
    "enabled": false
  }
}
